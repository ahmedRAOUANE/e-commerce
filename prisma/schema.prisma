// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id    Int     @id @default(autoincrement())
  email String  @unique
  name  String?
  password String
}

enum ProductStatus {
  DRAFT
  ACTIVE
  OUT_OF_STOCK
  // DISCONTINUED
}

model Products {
  id Int @id @default(autoincrement())
  
  name String
  description String
  
  price Int
  discount Int @default(0)
  salesCount Int @default(0)

  status ProductStatus @default(DRAFT)

  // TODO: these types are not strict, it can hold any type of data, add validation layer befor posting
  imgs Json 
  /*
    imgs: {
      alt: string,
      url: string
    }[]
  */
  
  tags Json? // String[]
  inventory Json 
  /*
    inventory: {
      sku: string,
      barcode: string,
      quantity: number
    }
  */

  shipping Json 
  /*
    shipping: {
      weight: number,
      length: number,
      width: number,
      height: number,
    }
  */

  metadata Json?
  /*
    metadata: {
      seo: {
        title: product.name,
        description: product.description
      },
      ...might add more later
    }
  */

  // relations
  categoryId Int
  // orderId Int
  category Categories @relation(fields: [categoryId], references: [id], onDelete: Restrict) 
  // order Orders @relation(fields: [orderId], references: [id], onDelete: Restrict) 
  orderItems OrderItem[]

  // product lifesicle
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // indexing
  @@index([categoryId])
}

enum CategoryStatus {
  ACTIVE
  INACTIVE
}
model Categories {
  id Int @id @default(autoincrement())

  name String @unique
  description String
  status CategoryStatus @default(ACTIVE)
  
  products Products[]

  metadata Json? // TODO: the metadata is optional for this version, might be required for future versions

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum OrderStatus {
  DELIVERED
  PROCESSING
  // SHIPPED // in case the shipping service is available
  PENDING
  CANCELED
}

enum OrderPayment {
  PAYED
  PENDING
  REFUNDED
}
model Orders {
  id Int @id @default(autoincrement())
  name String
  status OrderStatus @default(PROCESSING)
  orderId Int // (6degits-format) this will work as a serial number for the order, will be used later in case the owner wants to cancel the order
  payment OrderPayment @default(PENDING)

  // products
  // products Products[]
  orderItems OrderItem[]
  totalOrderedItemsCount Int
  // eachProdectCount Json
  /*
    eachProdectCount: {
      product: Product.name,
      count: number
    }
  */

  // owner
  ownerContact String // the owner email or phone number
  ownerName String? @default("unknown") // the owner name, optional - in case the owner prefered to not reveal his name

}

model OrderItem {
  id        Int @id @default(autoincrement())
  orderId   Int
  productId Int
  quantity  Int
  priceAtPurchase Int

  order   Orders   @relation(fields: [orderId], references: [id])
  product Products @relation(fields: [productId], references: [id])

  @@unique([orderId, productId])
}


enum Currency {
  DOLLAR
  DINAR
}

enum Languages {
  ENGLISH
  ARABIC
}
model AppData {
  id Int @id @default(autoincrement())
  storeName String
  supportEmail String
  phone String
  // currency Currency @default(DOLLAR) // TODO: this feature myght be implemented in future versions
  language Languages @default(ARABIC) 
  storeAddress String

  // appearence
  theme String
  primaryColor String

  // lifesicle
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Analytics {
  id Int @id @default(autoincrement())

  // products
  totalProductsCount Int @default(0)
  activeProductsCount Int @default(0) //? in stock products
  draftProductsCount Int @default(0)
  outOfStockProductsCount Int @default(0)
  totalItemsCount Int @default(0)

  // categories
  totalCategoryCount Int @default(0)
  activeCategoryCount Int @default(0)
  inactiveCategoryCount Int @default(0)

  // oreders
  totalOrdersCount Int @default(0)
  pendingOrdersCount Int @default(0)

  // revenu
}